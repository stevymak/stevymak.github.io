rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwnerUid(uid) {
      return signedIn() && uid != null && request.auth.uid == uid;
    }

    // L'e-mail du jeton ne prouve rien tant qu'il n'est pas vérifié :
    // n'importe qui peut créer un compte avec l'adresse d'un tiers.
    function isOwnerEmail(email) {
      return signedIn()
        && email is string
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    function reservationMutableFieldsOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'service',
        'dateKey',
        'time',
        'timeLabel',
        'heure',
        'adresse',
        'modificationNote',
        'modifiedAt',
        'status'
      ]);
    }

    // Le client peut annuler, ou modifier une demande en attente / confirmée
    // (elle repasse alors en 'pending'). Il ne peut pas rouvrir une réservation
    // annulée ou terminée.
    function reservationClientUpdateAllowed() {
      return request.resource.data.status in ['pending', 'cancelled']
        && resource.data.status in ['pending', 'confirmed']
        && reservationMutableFieldsOnly();
    }

    function validReservationCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
        'service', 'dateKey', 'timeLabel', 'price', 'nom',
        'telephone', 'email', 'adresse', 'status', 'createdAt'
      ])
      && d.keys().hasOnly([
        'service', 'dateKey', 'timeLabel', 'time', 'price', 'basePrice',
        'promoCode', 'promoDiscount', 'nom', 'telephone', 'email',
        'adresse', 'description', 'status', 'createdAt', 'uid'
      ])
      && (!('uid' in d)
        || (signedIn()
          && d.uid == request.auth.uid
          && d.email == request.auth.token.email))
      && str(d.get('service', null), 120)
      && str(d.dateKey, 10)
      && str(d.timeLabel, 40)
      && str(d.nom, 120)
      && str(d.telephone, 40)
      && str(d.email, 200)
      && str(d.adresse, 300)
      && (!('description' in d) || d.description == null || str(d.description, 3000))
      && d.status == 'pending';
    }

    function validContractCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
        'contrat', 'nom', 'email', 'telephone', 'adresse', 'status', 'createdAt'
      ])
      && d.keys().hasOnly([
        'contrat', 'type', 'societe', 'nom', 'email', 'telephone',
        'adresse', 'note', 'status', 'createdAt', 'uid'
      ])
      && (!('uid' in d)
        || (signedIn()
          && d.uid == request.auth.uid
          && d.email == request.auth.token.email))
      && d.contrat in [
        'decouverte', 'serenite', 'senior', 'famille',
        'pro-ponctuel', 'pro-essentiel', 'pro-confort', 'pro-premium',
        'maintenance-essentielle', 'maintenance-pro', 'maintenance-evolution'
      ]
      && str(d.nom, 160)
      && str(d.email, 200)
      && str(d.telephone, 40)
      && str(d.adresse, 300)
      && (!('societe' in d) || str(d.societe, 160))
      && (!('note' in d) || d.note == null || str(d.note, 3000))
      && d.status == 'new';
    }

    function validClientMessageCreate() {
      return request.resource.data.keys().hasAll([
        'uid',
        'email',
        'sujet',
        'texte',
        'createdAt',
        'lu'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.keys().hasOnly([
        'uid', 'email', 'sujet', 'texte', 'contratId', 'createdAt', 'lu'
      ])
      && str(request.resource.data.sujet, 200)
      && str(request.resource.data.texte, 3000)
      && request.resource.data.lu == false;
    }

    match /reservations/{reservationId} {
      allow read: if isAdmin() || isOwnerUid(resource.data.uid);

      // Public creation remains allowed for the current public booking flow.
      // Prefer migrating this to a backend or authenticated flow.
      allow create: if validReservationCreate();

      allow update: if isAdmin()
        || (isOwnerUid(resource.data.uid) && reservationClientUpdateAllowed());

      allow delete: if isAdmin();
    }

    // Créneaux pris : collection publique SANS données personnelles, lue et
    // écrite par makouez-it-rdv.html. Sans cette règle, le calendrier ne voit
    // aucun créneau occupé (tout est refusé par la règle finale).
    match /slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['dateKey', 'timeLabel'])
        && str(request.resource.data.dateKey, 10)
        && str(request.resource.data.timeLabel, 40);
      allow update, delete: if isAdmin();
    }

    match /contrats/{contratId} {
      allow read: if isAdmin() || isOwnerUid(resource.data.uid) || isOwnerEmail(resource.data.email);

      allow create: if validContractCreate();

      allow update, delete: if isAdmin();
    }

    match /messages_clients/{messageId} {
      allow create: if signedIn() && validClientMessageCreate();
      allow read, update, delete: if isAdmin();
    }

    match /avis/{avisId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /avis_en_attente/{avisId} {
      allow create: if request.resource.data.keys().hasAll([
        'nom',
        'comment',
        'note',
        'createdAt',
        'statut'
      ])
      && request.resource.data.keys().hasOnly(['nom', 'comment', 'note', 'createdAt', 'statut'])
      && str(request.resource.data.nom, 80)
      && str(request.resource.data.comment, 1000)
      && request.resource.data.note is int
      && request.resource.data.note >= 1
      && request.resource.data.note <= 5
      && request.resource.data.statut == 'en_attente';

      allow read, update, delete: if isAdmin();
    }

    match /devis_web/{devisId} {
      // Current public lead form.
      allow create: if request.resource.data.keys().hasAll([
        'type',
        'description',
        'budget',
        'delai',
        'nom',
        'email',
        'createdAt'
      ])
      && request.resource.data.keys().hasOnly([
        'type', 'description', 'budget', 'delai', 'nom', 'email', 'telephone', 'createdAt'
      ])
      && str(request.resource.data.type, 120)
      && str(request.resource.data.description, 3000)
      && str(request.resource.data.budget, 80)
      && str(request.resource.data.delai, 80)
      && str(request.resource.data.nom, 120)
      && str(request.resource.data.email, 200)
      && (!('telephone' in request.resource.data) || str(request.resource.data.telephone, 40));
      allow read, update, delete: if isAdmin();
    }

    // Méta-données client enrichies (tags, notes privées) gérées par
    // l'admin uniquement. Le doc id est un hash court (SHA-256 tronqué)
    // de l'email lowercase ou du téléphone normalisé.
    match /clients_meta/{hashId} {
      allow read, write: if isAdmin();
    }

    // Factures émises (admin only). Numérotation séquentielle gérée
    // via la collection counters/.
    match /factures/{factureId} {
      allow read, write: if isAdmin();
    }

    // Devis (admin only). Numérotation séquentielle gérée via counters/.
    // Conversion devis → facture : on crée un nouveau doc factures + on
    // met à jour le statut du devis avec factureId.
    match /devis/{devisId} {
      allow read, write: if isAdmin();
    }

    // Compteurs séquentiels (factures, devis…). Document id de la
    // forme `factures-2026` ou `devis-2026`. Mis à jour atomiquement
    // par l'admin via runTransaction côté client.
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Templates d'emails réutilisables (newsletter, fiche, promo, relance).
    match /templates/{tplId} {
      allow read, write: if isAdmin();
    }

    // Bibliothèque de fiches pratiques (liens PDF, catégories).
    // Les fiches peuvent être référencées dans les emails (variables
    // {{fiche_url}}) ou listées sur le site public.
    match /fiches_pdf/{ficheId} {
      allow read:  if true;          // catalogue public
      allow write: if isAdmin();
    }

    // Paramètres globaux de l'admin (automations, préférences).
    // Doc id de la forme `automations`, `general`…
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Campagnes d'envoi (newsletters, promos…). Stats remplies par le
    // webhook Resend côté Cloud Functions.
    match /campagnes/{campId} {
      allow read, write: if isAdmin();
    }

    // Données publiques en lecture seule (ex. avis Google synchronisés par une Cloud Function).
    match /public/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
